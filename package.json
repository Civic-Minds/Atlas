{
  "name": "atlas",
  "private": true,
  "description": "A hosted frequency map for transit routes.",
  "version": "3.2.21",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "vite",
    "dev:api": "npx tsx api-dev-server.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "typecheck:workers": "tsc --noEmit -p tsconfig.workers.json",
    "test": "vitest run",
    "process": "npx tsx pipeline/process-gtfs.ts",
    "process:staging": "ATLAS_ENV=staging npx tsx pipeline/process-gtfs.ts",
    "refresh": "npx tsx pipeline/refresh.ts",
    "refresh:staging": "ATLAS_ENV=staging npx tsx pipeline/refresh.ts",
    "restore-active-feeds": "npx tsx pipeline/restore-active-feeds.ts",
    "audit-active-feeds": "npx tsx pipeline/audit-active-feeds.ts",
    "audit-current-gtfs": "npx tsx pipeline/audit-current-gtfs.ts",
    "build-pmtiles": "npx tsx pipeline/build-pmtiles.ts",
    "build-pmtiles:staging": "ATLAS_ENV=staging npx tsx pipeline/build-pmtiles.ts",
    "build-pmtiles-incremental": "npx tsx pipeline/build-pmtiles-incremental.ts",
    "build-pmtiles-incremental:staging": "ATLAS_ENV=staging npx tsx pipeline/build-pmtiles-incremental.ts",
    "upload-pmtiles:staging": "ATLAS_ENV=staging npx tsx pipeline/upload-pmtiles.ts",
    "dev:staging": "ATLAS_ENV=staging VITE_R2_PUBLIC_URL=https://pub-5f1c48f86b024c42a8d174a4a5dd69ca.r2.dev vite",
    "route-report": "npx tsx pipeline/route-report.ts",
    "build-history": "npx tsx pipeline/build-history.ts",
    "build-hidden-routes": "npx tsx pipeline/build-hidden-routes.ts",
    "migrate-archive": "npx tsx pipeline/migrate-gtfs-archive.ts",
    "validate-headsigns": "npx tsx scripts/validate-headsign-split.ts",
    "validate-index": "npx tsx pipeline/validate-index.ts",
    "build:agency-index": "npx tsx scripts/build-agency-index.ts",
    "record-feed-review": "npx tsx scripts/record-feed-review.ts",
    "verify:live-contract": "npx tsx scripts/verify-live-contract.ts",
    "sync-feed-refresh-meta": "npx tsx scripts/sync-feed-refresh-meta.ts",
    "audit-frequency": "npx tsx scripts/audit-frequency.ts",
    "audit-feed-freshness": "npx tsx scripts/audit-feed-freshness.ts",
    "audit-expired-sources": "npx tsx scripts/audit-expired-sources.ts",
    "poc:burlington": "npx tsx scripts/poc/burlington-rt.ts",
    "poc:hamilton": "npx tsx scripts/poc/hamilton-rt.ts",
    "find-mdb": "npx tsx pipeline/find-mdb-feed.ts",
    "discover-gaps": "npx tsx pipeline/discover-gaps.ts",
    "upload-pmtiles": "npx tsx pipeline/upload-pmtiles.ts",
    "verify-pmtiles-coverage": "npx tsx pipeline/verify-pmtiles-coverage.ts",
    "sync-agency-count": "node -e \"const fs=require('fs');const count=JSON.parse(fs.readFileSync('public/data/index.json','utf8')).agencies.length;const p='docs/AGENCIES.md';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/^(\\d+) agencies as of/m,count+' agencies as of'));console.log('Updated AGENCIES.md: '+count+' agencies');\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/lib-storage": "^3.1121.0",
    "@deck.gl/core": "^9.3.10",
    "@deck.gl/layers": "^9.3.10",
    "@deck.gl/mapbox": "^9.3.10",
    "@mapbox/vector-tile": "^3.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^17.4.2",
    "gtfs-realtime-bindings": "^2.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.35.0",
    "maplibre-gl": "^5.24.0",
    "papaparse": "^5.7.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "brace-expansion": "^2.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@mapbox/vector-tile": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.1",
    "pbf": "^5.1.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
