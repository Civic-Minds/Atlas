{
  // Atlas Studio MCP, hosted pilot (CIV-1840). Read-only: it reads the published release over HTTP and writes only its
  // own tester list and call log. Run locally with `wrangler dev`; nothing here is deployed yet.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atlas-studio-mcp",
  "account_id": "334f99db1478f9e95eaea65b3b9e1fdd",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  // Invocation logs would record each request URL, and a tester's link carries their token in the path: keep them off.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "vars": {
    // Where the published data lives (the release pointer is DATA_ORIGIN/atlas/release.json).
    "DATA_ORIGIN": "https://data.transitatlas.fyi",
    // Fair use per tester (placeholders for the manager to confirm): calls a day, and the burst limit below.
    "DAILY_CALL_CAP": "300"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "atlas-studio-mcp", "database_id": "19dabe73-5f54-4f50-8135-adb62d3a2154", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    // 30 calls a minute per tester, per Cloudflare location (approximate). The namespace id is a placeholder.
    { "name": "TESTER_LIMIT", "namespace_id": "184001", "simple": { "limit": 30, "period": 60 } }
  ]
  // Secret, set with `wrangler secret put ADMIN_TOKEN` (locally in .dev.vars): ADMIN_TOKEN guards /admin/*.
  // Local testing only: MCP_DATA_BASE (in .dev.vars) points the data reader at a folder served over HTTP.
}
