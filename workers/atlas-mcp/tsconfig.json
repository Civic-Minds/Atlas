{
  // The hosted MCP Worker and the MCP code it shares with the local server (scripts/mcp, shared/mcp*). The shared code
  // pulls in the app's own types (DOM, Vite), so this has its own config instead of tsconfig.workers.json. The app's files it imports are checked by the root tsconfig, so
  // `npm run typecheck:mcp-worker` reports only errors in the Worker and the MCP files.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client", "@cloudflare/workers-types"]
  },
  "include": ["src", "worker-configuration.d.ts", "../../scripts/mcp/*.ts", "../../shared"]
}
