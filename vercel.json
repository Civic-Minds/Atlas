{
  "headers": [
    {
      "source": "/assets/:file([^/]+-[A-Za-z0-9_-]{8}\\.[A-Za-z0-9]+)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/history-adherence",
      "destination": "/api/history-adherence.ts"
    },
    {
      "source": "/api/privacy-region",
      "destination": "/api/geo.ts?mode=privacy-region"
    },
    {
      "source": "/beta-data/:path*",
      "destination": "https://pub-5f1c48f86b024c42a8d174a4a5dd69ca.r2.dev/:path*"
    },
    {
      "source": "/((?!api/|@vite|@react-refresh|node_modules/|src/).*)",
      "destination": "/index.html"
    }
  ]
}
