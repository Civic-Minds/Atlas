# Atlas environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Atlas mode ---
# public, preview, beta, or dev. This is the single deployment mode setting.
VITE_ATLAS_MODE=dev

# --- Feature flags ---
VITE_LIVE_ENABLED=false
# Live route and agency report pages only, reading published JSON from R2 (no realtime endpoints)
VITE_LIVE_REPORTS_ENABLED=false
VITE_HISTORY_ENABLED=false
VITE_CARD_CLICK_TO_FLAG_ENABLED=false
VITE_UNEVEN_BANNER_ENABLED=false
VITE_HISTORY_DAY_PICKER_ENABLED=false
# Legacy mode flags; leave unset when VITE_ATLAS_MODE is configured.
VITE_BETA_BUILD=false
VITE_PREVIEW_BUILD=false

# --- R2 (pipeline process/refresh, PMTiles upload, private archive/live reads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=atlas
R2_PUBLIC_URL=https://your-public-atlas-cdn.example
R2_ARCHIVE_BUCKET_NAME=atlas-archive
R2_LIVE_BUCKET_NAME=atlas-live
# Read-only keys (local only, picked out of the MAIN checkout's .env.local by local-api; never the write keys above).
# R2_RO_*: Object Read on the data and archive buckets (also the GitHub dry-run token).
# R2_LIVE_READ_*: Object Read on the private Live bucket MCP_LIVE_BUCKET only (Studio's files, Live coverage; #1928).
# Without R2_LIVE_READ_* the dev server falls back to R2_RO_*, which that bucket refuses: Studio's pages read "No data".
R2_RO_ACCESS_KEY_ID=
R2_RO_SECRET_ACCESS_KEY=
R2_LIVE_READ_ACCESS_KEY_ID=
R2_LIVE_READ_SECRET_ACCESS_KEY=
MCP_LIVE_BUCKET=atlas-mcp-live

# --- Live GTFS-RT (Vercel / local dev:api) — only needed for key-gated agencies ---
TRANSLINK_API_KEY=
STM_API_KEY=
MUNI_511_API_KEY=
# Parked LA Metro rail until active:false is flipped
SWIFTLY_API_KEY=

# --- Static GTFS feed keys (refresh pipeline; also GitHub Actions secrets) ---
# Referenced by feedApiKeyEnvVar in config/agencies/*.json. Never commit values.
CATA_LANSING_API_KEY=
GRAND_EST_API_KEY=
# Lyon TCL (not wired to a config yet; feedUrl is null)
LYON_API_KEY=
LYON_API_SECRET=

# CARTO basemap. Builds load tiles straight from CARTO with the public key in src/lib/basemap.ts (locked to
# transitatlas.fyi); VITE_CARTO_BASEMAP_KEY overrides it. Local dev goes through the dev server's /api/carto-tiles
# with this server key (localhost is not on the public key): keep it private; never commit the value.
VITE_CARTO_BASEMAP_KEY=
CARTO_BASEMAP_API_KEY=

# Google Analytics 4 — public measurement ID, production builds only.
VITE_GA_MEASUREMENT_ID=

# --- Optional / niche ---
# MDB_REFRESH_TOKEN=   # Mobility Database token for some discovery scripts
