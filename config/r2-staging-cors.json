{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://www.beta.transitatlas.fyi",
          "http://127.0.0.1:4178",
          "http://localhost:4178",
          "http://127.0.0.1:5173",
          "http://localhost:5173"
